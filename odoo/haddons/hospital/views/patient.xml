<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hospital_patient_form" model="ir.ui.view">
            <field name="name">hospital.patient.form</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h4>
                                <field name="ref" readonly="1"/>
                            </h4>
                            <h2>
                                <label for= "name" string="Nom" class="oe_edit_only"/>
                                <field name="name"/>
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="date_of_birth"/>
                                <field name="age"/>
                                <field name="appointment_count"/>
                                <field name="appointment_id"/>
                            </group>
                            <group>
                                <field name="gender" invisible="context.get('hide_gender')" widget="radio"/>
                                <field name="tag_ids" widget="many2many_checkboxes" options="{'color_field':'color'}"/>
                                <field name="active" invisible ="1"/>
                            </group>
                        </group>

                        <group name="orther_info" string="Autres informations">
                            <field name="parent" attrs="{'invisible': [('age', '>', 35)]}"/>
                            <field name="marital_status" attrs="{'invisible' : [('age', '&lt;=', 18)]}"/>
                            <field name="partner_name" attrs="{'readonly' : [('marital_status', '!=', 'married')], 
                                                            'required' : [('marital_status', '=', 'married')]}"/>
                        </group>
                    </sheet>
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_hospital_patient_tree" model="ir.ui.view">
            <field name="name">hospital.patient.tree</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <tree export_xlsx="0">
                    <field name="name" string="Nom patient"/>
                    <field name="ref"/>
                    <field name="age" avg="Moyenne d'age"/>
                    <field name="appointment_count" sum="Total rdv"/>
                     <field name="gender"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>


                </tree>
            </field>
        </record>

        <record id="view_hospital_patient_search" model="ir.ui.view">
            <field name="name">hospital.patient.search</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Nom patient" filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]"/>
                    <field name="ref"/>
                    <field name="age"/>
                    <field name="gender"/>
                    <filter name="filter_female" string="Féminin" domain="[('gender', '=', 'female')]"/>
                    <!-- <separator/> -->
                    <filter name="filter_male" string="Masculin" domain="[('gender', '=', 'male')]"/>
                    <filter name="filter_kids" string="Enfant(s)" domain="[('age', '&lt;=', 28)]"/>
                    <filter name="filter_archive" string="Archivé(s)" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Genre" name="grpup_by_gender" context="{'group_by':'gender'}"/>
                    </group>
                    <searchpanel>
                        <field name="gender" select="multi" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>
        
        <record id="action_hospital_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hospital.patient</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_filter_male':1, 'search_default_group_by_gender':1}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create your first patient
              </p>
            </field>

        </record>

    </data> 
</odoo>
