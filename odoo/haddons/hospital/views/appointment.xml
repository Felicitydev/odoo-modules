<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hospital_appointment_activity" model="ir.ui.view">
            <field name="name">hospital.appointment.activity</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <activity string="Rendez-vous">
                    <field name="patient_id"/>
                    <templates>
                        <div t-name="activity-box">
                            <img t-att-src="activity_image('hospital.patient', 'image', record.patient_id.raw_value)" t-att-title="record.patient_id.value" t-att-alt="record.patient_id.value"/>
                            <div>
                                <field name="ref" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

        <record id="view_hospital_appointment_form" model="ir.ui.view">
            <field name="name">hospital.appointment.form</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <form> <!-- <form>create ="0" delete ="0" copy="0" edit="0" -->
                    <header>
                        <button name="action_in_consultation" string="En Consultation" class="oe_highlight" type="object" states="draft"/>
                        <button name="action_done" string="Marqué comme Fait" class="oe_highlight" type="object" states="in_consultation" data-hotkey="v"/>
                        <!-- <button name="%(hospital.action_cancel_appointment)d" string="Annuler" type="action" states="draft,in_consultation" data-hotkey="z"/> Syntaxe à utiliser pour appeler un bouton définir dans une autre vue -->
                        <button name="action_cancel" string="Annuler" type="object" states="draft,in_consultation" data-hotkey="z" context="{'hide_appointment': 1}"/> <!-- add this code to call default name of patient when it appointment is cancelled : context="{'default_appointment_id': active_id}" -->
                        <button name="action_draft" string="Remettre à l'état brouillon" type="object" states="cancel" data-hotkey="d"/>
                        <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,in_consultation,done,cancel"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="priority" widget="priority" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="patient_id"/>
                                <field name="ref"/>
                                <field name="ref2"/>
                                <field name="gender"/>
                                <field name="active" invisible="1"/>
                                <field name="doctor_id" widget="many2one_avatar_user"/>
                            </group>
                            <group>
                                <field name="appointment_time"/>
                                <field name="hide_sales_price" groups="base.group_no_one"/>
                                <field name="booking_date" help="dete de réservation" default_focus="1"/> <!--default_focus="1" using when opening the form it's the field by default  -->
                                <button name="action_test" string="object button" type="object" class="oe_highlight" confirm="Etes-vous sur de vouloir ouvrir le code python?"/>
                                <button name="%(hospital.action_hospital_patient)d" string="action button" type="action" confirm="Etes-vous sur de vouloir ouvrir la vue des patients?" class="oe_highlight" help="En cliquant ici vous serez redirigez vers la vue des patients"/>
                            </group>
                        </group>
                        <notebook>
                            <page string = "Prescription" name="prescription">
                                <field name="prescription" placeholder = "Entrez votre prescription" options="{'collaborative' : true, 'resizable': true, 'codeview':true}"/>
                            </page>
                            <page string = "Pharmacie" name="pharmacy">
                                <field name="pharmacy_line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="price" attrs="{'column_invisible': [('parent.hide_sales_price','=', True)]}"/>
                                        <field name="qty"/>
                                    </tree>
                                    <form>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="price" attrs="{'column_invisible': [('parent.hide_sales_price','=', True)]}"/>
                                            <field name="qty"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>

            </field>
        </record>

        <record id="view_hospital_appointment_tree" model="ir.ui.view">
            <field name="name">hospital.appointment.tree</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <tree decoration-success="state =='done'" decoration-danger="state == 'cancel'" decoration-muted="state == 'in_consultation'" sample="1" multi_edit="1">
                <!-- <tree create ="0" delete ="0" copy="0" edit="0">  -->
                    <header>
                        <button name="action_in_consultation" string="En Consultation" type="object"/>
                    </header>
                    <field name="patient_id"/>
                    <field name="gender"/>
                    <field name="doctor_id" widget="many2one_avatar"/> <!-- using widget="many2one_avatar_user" open the discuss app-->
                    <field name="appointment_time"/>
                    <field name="ref" optional="hide"/>
                    <field name="ref2"/>
                    <field name="booking_date" optional="show"/>
                    <field name="activity_ids" widget="list_activity"/>
                    <field name="state"
                           decoration-success="state =='done'" 
                           decoration-info="state == 'draft'" 
                           decoration-muted="state == 'in_consultation'" 
                           decoration-danger="state == 'cancel'" 
                           widget="badge"/>
                    <button name="action_done" type="object" class="fa fa-check btn-success" attrs="{'invisible': [('state', '!=', 'in_consultation')]}"/>
                    <button name="action_cancel" type="object" class="fa fa-times btn-danger" context="{'hide_appointment': 1}" attrs="{'invisible': [('state', 'not in', ('draft','in_consultation'))]}"/> 

                </tree>
            </field>
        </record>

        <record id="view_hospital_patient_search" model="ir.ui.view">
            <field name="name">hospital.patient.search</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <search>
                    <!-- <searchpanel>
                        <field name="gender" select="multi" enable_counters="1"/>
                    </searchpanel> -->
                </search>
            </field>
        </record>
        
        <record id="action_hospital_appointment" model="ir.actions.act_window">
            <field name="name">Rdv</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hospital.appointment</field>
            <field name="view_mode">tree,form,activity</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create your first appointment
              </p>
            </field>

        </record>

    </data> 
</odoo>
