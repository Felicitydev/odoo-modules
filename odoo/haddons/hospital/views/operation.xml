<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_patient_operation_tree" model="ir.ui.view">
            <field name="name">patient.operation.tree</field>
            <field name="model">hospital.operation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="doctor_id"/>
                    <field name="operation_name"/>
                </tree>
            </field>
        </record>

        <record id="view_patient_operation_form" model="ir.ui.view">
            <field name="name">patient.operation.form</field>
            <field name="model">hospital.operation</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="doctor_id"/>
                                <field name="operation_name"/>
                                <field name="refernce_record"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_patient_operation" model="ir.actions.act_window">
            <field name="name">Opérations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hospital.operation</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create your first operation!
              </p>
            </field>

        </record>

    </data> 
</odoo>
